<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Adds a "Send via WhatsApp" button next to Print on the
             Customer Invoice form, without modifying the core view. -->
        <record id="view_move_form_whatsapp_share" model="ir.ui.view">
            <field name="name">account.move.form.whatsapp.share</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="(//button[@name='action_print_pdf'])[1]" position="after">
                    <widget name="whatsapp_share_widget"
                            invisible="move_type not in ('out_invoice', 'out_refund') or state != 'posted'"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
