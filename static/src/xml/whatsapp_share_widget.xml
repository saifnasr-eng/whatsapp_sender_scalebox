<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">

    <t t-name="whatsapp_sender_scalebox.WhatsappShareWidget">
        <button type="button"
                class="btn btn-secondary"
                t-on-click="onClick"
                t-att-disabled="state.loading">
            <i t-attf-class="fa {{state.loading ? 'fa-spin fa-circle-o-notch' : 'fa-whatsapp'}} me-1"/>Send via WhatsApp
        </button>
    </t>

</templates>
